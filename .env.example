QQ_BOT_APP_ID=your_app_id_here
QQ_BOT_CLIENT_SECRET=your_client_secret_here
# 入向回复兜底 openid（入向事件缺 user_openid 时用）；不是出向投递目标
QQ_OPEN_ID=your_openid_here

REDIS_URL=redis://localhost:6379
REDIS_MSGS_STREAM=stream:msgs:in
REDIS_RENDERED_STREAM=stream:rendered:qq
REDIS_RECEIPTS_STREAM=stream:receipts
QQ_RATE_LIMIT_PER_MIN=30
RETRY_MAX_ATTEMPTS=3
